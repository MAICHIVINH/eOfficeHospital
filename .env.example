# ==============================================================================
# HOSPITAL E-OFFICE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and update the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOCKER PORTS CONFIGURATION
# ------------------------------------------------------------------------------
DB_PORT=5432
API_PORT=5020
CLIENT_PORT=7081
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
PGADMIN_PORT=5051

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=qlvb_hospital
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
# Connection string for Local Dev (outside Docker):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=qlvb_hospital;Username=postgres;Password=your_postgres_password
# Connection string inside Docker container network:
DOCKER_DB_CONNECTION=Host=db;Port=5432;Database=qlvb_hospital;Username=postgres;Password=your_postgres_password

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JwtSettings__SecretKey=your-super-secret-key-change-this-in-production-min-32-characters
JwtSettings__Issuer=QLVB.Hospital
JwtSettings__Audience=QLVB.Hospital.Users
JwtSettings__ExpirationHours=8

# ------------------------------------------------------------------------------
# 4. MINIO OBJECT STORAGE
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Endpoint for Local Dev (outside Docker):
MinioSettings__Endpoint=localhost:9100
# Endpoint inside Docker container network:
DOCKER_MINIO_ENDPOINT=minio:9000
MinioSettings__AccessKey=minioadmin
MinioSettings__SecretKey=minioadmin123
MinioSettings__BucketName=hospital-documents
MinioSettings__UseSSL=false

# ------------------------------------------------------------------------------
# 5. PGADMIN (DATABASE MANAGEMENT UI)
# ------------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ------------------------------------------------------------------------------
# 6. FILE UPLOAD CONFIGURATION
# ------------------------------------------------------------------------------
FileUpload__MaxFileSizeMB=50
FileUpload__AllowedExtensions__0=.pdf

# ------------------------------------------------------------------------------
# 7. EMAIL NOTIFICATION (SMTP)
# ------------------------------------------------------------------------------
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=your_email@gmail.com
EmailSettings__SmtpPassword=your_app_password
EmailSettings__EnableSsl=true
EmailSettings__SenderName=Bệnh viện Đa khoa Tâm Trí Cao Lãnh
EmailSettings__SenderEmail=your_email@gmail.com
EmailSettings__AppBaseUrl=http://localhost:5173

# ------------------------------------------------------------------------------
# 8. SYSTEM & LOGGING
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
AllowedHosts=*
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
